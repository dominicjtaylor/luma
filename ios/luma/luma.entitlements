<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Live Activities with local (non-push) updates do not require a special
      entitlement beyond NSSupportsLiveActivities in Info.plist.

      If you later add push-based activity updates, add:
        <key>com.apple.developer.usernotifications.push-to-start</key>
        <true/>
    -->
    <key>com.apple.developer.associated-domains</key>
    <array/>
</dict>
</plist>
